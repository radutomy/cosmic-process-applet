<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.github.radutomy.cosmic-process-applet</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MPL-2.0</project_license>
  <name>Process Killer</name>
  <summary>Show and force-kill the user applications using the most memory</summary>
  <description>
    <p>
      A COSMIC panel applet that lists up to seven user applications or process
      groups using the most proportional memory and provides an immediate
      force-kill action for each.
    </p>
  </description>
  <url type="homepage">https://github.com/radutomy/dotnix</url>
  <url type="vcs-browser">https://github.com/radutomy/dotnix</url>
  <launchable type="desktop-id">com.github.radutomy.cosmic-process-applet.desktop</launchable>
  <provides>
    <id>com.system76.CosmicApplet</id>
    <binary>cosmic-process-applet</binary>
  </provides>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <categories>
    <category>COSMIC</category>
    <category>System</category>
  </categories>
  <content_rating type="oars-1.1" />
</component>
